{
    "name": "jesusvaleradev/transforming-legacy-php",
    "description": "Transforming Legacy PHP: Refactoring Techniques in Theory and Practice",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "ext-mysqli": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "setup": "bash setup.sh",
        "start": "XDEBUG_MODE=off php run.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
